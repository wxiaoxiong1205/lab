# 后端服务配置
# 默认使用开发环境后端
BACKEND_HOST=deepexilab-dev.deepexi.com
BACKEND_PORT=443
BACKEND_PROTOCOL=https

# 镜像标签配置
IMAGE_TAG_FRONTEND=latest

# 示例：使用其他后端服务
# BACKEND_HOST=your-backend-server.com
# BACKEND_PORT=8080
# BACKEND_PROTOCOL=http

# 示例：使用本地后端服务
# BACKEND_HOST=localhost
# BACKEND_PORT=8000
# BACKEND_PROTOCOL=http 