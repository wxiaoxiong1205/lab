# ==================== lab对外暴露地址 ====================
#  LAB_EXPORT_ADDRESS = 10.201.0.20:32000 或 deepexilabxxx.deepexi.com
LAB_EXPORT_PROTOCOL=http
LAB_EXPORT_ADDRESS=xxxx
LAB_EXPORT_PATH=

# ==================== 数据库配置 ====================
# PostgreSQL示例配置
DATABASE_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dataset_mg

# ==================== MLFLOW数据库配置(非必填，如果有要求专库对应专门的用户时配置，不配置就使用通用数据库配置) ====================
MLFLOW_DATABASE_TYPE=postgresql
MLFLOW_DB_HOST=localhost
MLFLOW_DB_PORT=5432
MLFLOW_DB_USER=postgres
MLFLOW_DB_PASSWORD=postgres

# 存储元数据url（pgsql密码最好url编码）
STORAGE_METAURL=postgres://postgres:xxxx@xxxxxx:5432/juicefs


# ==================== Redis配置 ====================
# Redis 用于缓存、会话存储和Celery结果后端
# NORMAL_REDIS_HOST=101.126.54.83
# NORMAL_REDIS_PORT=30002
# NORMAL_REDIS_PASSWORD=root
# NORMAL_REDIS_DB=0

REDIS_SENTINEL=enable
REDIS_SENTINEL_HOST_PORT=10.201.0.20:26379,10.201.0.20:26380,10.201.0.20:26381
REDIS_MASTER_NAME=mymaster
REDIS_SENTINEL_PASSWORD=
REDIS_NODE_PASSWORD=root
REDIS_SENTINEL_DB=0


# ==================== 安全配置 ====================
JWT_SECRET_KEY=d20a0382a5f840f7afbd3f4df92ecaf8
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=14400

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_RETENTION="30 days"
LOG_ROTATION="1 day"
LOG_TO_STDOUT=true
LOG_TO_FILE=true



# ==================== Celery配置 ====================
# Celery 任务队列配置（Broker和Result Backend使用上述Redis配置）
CELERY_TIMEZONE=Asia/Shanghai

# ==================== MinIO配置 ====================
# MinIO 对象存储 - 用于文件存储和归档
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=deepexilab
MINIO_SECRET_KEY=Deepexi@123
MINIO_SECURE=false
MINIO_BUCKET=deepexilab

# ==================== 集群命名配置 ====================
KUBERNETES_NAMESPACE_PREFIX=deepexilab

# ==================== juicefs指定CS版本对应镜像仓库避免多tag错误 ====================
JUICEFS-CSI-DRIVER-TAG=v0.29.0
CSI-DASHBOARD-TAG=v0.29.0
LIVENESSPROBE-TAG=v2.12.0
CSI-NODE-DRIVER-REGISTRAR-TAG=v2.9.0
CSI-RESIZER-TAG=v1.9.0

# ==================== MLflow配置 ====================
# MLflow 模型训练跟踪服务器配置
LAB_MLFLOW_HOST=101.126.150.150
LAB_MLFLOW_PORT=8078
MLFLOW_DB=mlflowdb
# MLflow后端存储URI（自动从数据库配置生成，通常不需要手动设置）
# MLFLOW_BACKEND_STORE_URI=postgresql://postgres:password@localhost:5432/mlflowdb

# ==================== Kubernetes配置 ====================
# Kubernetes镜像拉取策略
# IfNotPresent: 本地不存在时才拉取（默认，启动快）
# Always: 总是拉取最新镜像（开发调试时使用，启动慢）
# Never: 从不拉取，只使用本地镜像
K8S_IMAGE_PULL_POLICY=IfNotPresent

# ==================== 集群动态端口配置 ====================
START_PORT=30000
END_PORT=31000

# ==================== Loki 配置 ====================
# 内部查询（后端服务直接访问 Loki 查询日志）
LOKI_PROTOCOL=http
LOKI_ADDRESS=loki:3100

# 外部推送（alloy 回传日志，可选，不配置时 fallback 到 LAB_EXPORT_*）
# 本地调试时可配置直接访问 Loki，跳过 ingress
# LOKI_PUSH_PROTOCOL=http
# LOKI_PUSH_ADDRESS=localhost:3100

# ==================== ssh配置 ====================
SSH_GATEWAY_EXPORT=2222
SSH_AES_KEY=Q5v26YNkMS2MHQfYfvYr6NONZZMI0k-WbeS5YfwzQ9w=
SSH_BASE64_KEY=deepexilab_key_ssh

# ==================== 对接控制台的相关配置 ====================
FASTDATA_WORKBENCH_URL_PRE=http://10.201.0.65:32080/deepexi-console/api
# 这个appId控制台那边会固定下来
APP_ID=1442199057321728
ADMIN_ROLE_NAME=模型训练管理员

# ==================== 全局适配客户环境切换 ====================
PROVIDER_TYPE=default
# PROVIDER_TYPE=belle

# BELLE_API_URL_PRE=https://ai-base-test.belle.cn
# BELLE_API_CLIENT_ID=di-pu
# BELLE_API_CLIENT_KEY=QU7iGYFREBashJtk0kChbNjjtApaTsec
# BELLE_RESOURCES_RATIO=0.4

# BELLE_TRAINING_ENV_VARIABLES='[{"var_key":"NCCL_IB_DISABLE" , "var_value": "0"}, {"var_key":"NCCL_P2P_DISABLE" , "var_value": "0"}, {"var_key":"NCCL_SHM_DISABLE" , "var_value": "0"}]'


# ==================== k8s标签同步定时任务 ====================
K8S_LABELS_SCHEDULER_CRON=*/10 * * * *

# ==================== 数据清洗配置 ====================
# 清洗任务并行进程数
DATA_JUICER_WORKERS=4
# K8s 资源配置
DATA_CLEANING_CPU_LIMIT=2
DATA_CLEANING_CPU_REQUEST=2
DATA_CLEANING_MEMORY_LIMIT=4Gi
DATA_CLEANING_MEMORY_REQUEST=4Gi
# 算子配置文件路径（支持 Docker 挂载，可选）
# 如果设置此环境变量，将从此路径加载算子配置
# 如果不设置，默认从 app/config/data_cleaning_operators.json 加载
# DATA_CLEANING_OPERATORS_CONFIG_PATH=/app/config/data_cleaning_operators.json

# ==================== DGI服务健康检查地址 ====================
DGI_SERVICE_HEALTH_URL=http://deepai-gateway-backend:3000/api_v2/health
# ==================== proxy-notebook 访问静态GC阈值 ====================
NOTEBOOK_STATIC_CACHE_MAX_NOTEBOOKS=100

# ==================== APISIX OpenAPI 应用消费者同步配置 ====================
OPENAPI_SECRET_AES_KEY=JLq5BKeysGt6EQH8qsletp_t44d0L59wseMm1drcRyI=
APISIX_ADMIN_HOST=http://deepai-lab-apisix-admin
APISIX_ADMIN_API_KEY=edd1c9f034335f136f87ad84b625c8f1
APISIX_ADMIN_TIMEOUT=10
APISIX_HMAC_AUTH_CLOCK_SKEW=300
